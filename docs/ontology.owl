    <rdf:Description>
        <rdfs:comment xml:lang="en">If a device has risk class ClassD, then it is classified as a HighRiskDevice.</rdfs:comment>
        <rdfs:label xml:lang="en">Rule 2 - IVDR Class D devices are high risk</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
