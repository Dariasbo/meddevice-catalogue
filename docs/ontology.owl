        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#RiskCategory"/>
        <rdfs:comment xml:lang="en">Relates a risk to its general risk category.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskCategory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#RiskClass"/>
        <rdfs:comment xml:lang="en">Relates a device to its regulatory risk class.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasRiskType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasRiskType">
