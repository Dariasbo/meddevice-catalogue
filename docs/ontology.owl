        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#PatientSex"/>
        <rdfs:comment xml:lang="en">Relates an incident to the reported patient sex.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPatientSex</rdfs:label>
    </owl:ObjectProperty>
    


