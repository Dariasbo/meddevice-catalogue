        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#RiskType"/>
        <rdfs:comment xml:lang="en">Relates a risk to its risk type.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasSeverityLevel -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasSeverityLevel">
