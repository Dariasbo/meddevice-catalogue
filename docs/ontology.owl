        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#ProbabilityLevel"/>
        <rdfs:comment xml:lang="en">Relates a risk to its probability level.</rdfs:comment>
