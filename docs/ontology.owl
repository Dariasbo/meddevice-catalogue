        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Country"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to its country.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocatedInCountry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#isRegulatedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#isRegulatedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">Relates a device to the applicable regulatory framework.</rdfs:comment>
        <rdfs:label xml:lang="en">isRegulatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#isSupervisedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#isSupervisedBy">
