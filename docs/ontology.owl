    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/meddevice-catalogue#affectsDevice -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#affectsDevice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:comment xml:lang="en">Relates an incident to the affected device.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#affectsDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#affectsDeviceType">
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#DeviceType"/>
        <rdfs:comment xml:lang="en">Indicates the type of device affected by a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsDeviceType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasActionStatus -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasActionStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#ActionStatus"/>
        <rdfs:comment xml:lang="en">Relates a corrective action to its current status.</rdfs:comment>
        <rdfs:label xml:lang="en">hasActionStatus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasActionType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasActionType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#ActionType"/>
        <rdfs:comment xml:lang="en">Relates a corrective action to its action type.</rdfs:comment>
        <rdfs:label xml:lang="en">hasActionType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasAssociatedRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasAssociatedRisk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:comment xml:lang="en">Relates an incident to its associated risk.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAssociatedRisk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#hasDeviceType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#DeviceType"/>
        <rdfs:comment xml:lang="en">Relates a device to its device type.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDeviceType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#hasIncidentType -->


