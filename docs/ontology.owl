        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#SeverityLevel"/>
        <rdfs:comment xml:lang="en">Relates a risk to its severity level.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSeverityLevel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#isLocatedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#isLocatedInCountry">
