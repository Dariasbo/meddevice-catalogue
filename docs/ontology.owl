        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates an incident to the reporting manufacturer or entity.</rdfs:comment>
        <rdfs:label xml:lang="en">reportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/meddevice-catalogue#reportedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.example.org/meddevice-catalogue#reportedInCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Country"/>
        <rdfs:comment xml:lang="en">Relates an incident to the country where it was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">reportedInCountry</rdfs:label>
    </owl:ObjectProperty>
    


