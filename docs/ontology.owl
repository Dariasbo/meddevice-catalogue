<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/meddevice-catalogue#"
     xml:base="http://www.example.org/meddevice-catalogue"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:meddevice-catalogue="http://www.example.org/meddevice-catalogue#">
    <owl:Ontology rdf:about="http://www.example.org/meddevice-catalogue">
        <owl:versionIRI rdf:resource="http://www.example.org/meddevice-catalogue/1.0.0"/>
        <terms:bibliographicCitation xml:lang="en">David. European High-Risk Medical Devices and IVD Catalogue Ontology. Version 1.0.0, 2026.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-26</terms:created>
        <terms:creator>David</terms:creator>
        <terms:description xml:lang="en">Ontology for representing medical devices, IVD devices, manufacturers, risk classes, risks, incidents and field safety corrective actions based on the CSV files provided in the PEC.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-26</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher xml:lang="en">Universitat Oberta de Catalunya</terms:publisher>
        <terms:source xml:lang="en">CSV files provided in the PEC: dispositivos, fabricantes, riesgos, incidentes and acciones correctivas.</terms:source>
        <terms:title xml:lang="en">European High-Risk Medical Devices and IVD Catalogue Ontology</terms:title>
        <vann:preferredNamespacePrefix>meddevice</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://www.example.org/meddevice-catalogue#"/>
        <rdfs:comment xml:lang="en">Ontology created for a university assignment on semantic web and knowledge representation.</rdfs:comment>
        <rdfs:label xml:lang="en">European medical device catalogue ontology</rdfs:label>
        <owl:versionInfo xml:lang="en">Version 1.0.0</owl:versionInfo>
    </owl:Ontology>
    


