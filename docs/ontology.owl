    <rdf:Description>
        <rdfs:comment xml:lang="en">If a corrective action has OpenStatus, then it is classified as OpenCorrectiveAction.</rdfs:comment>
        <rdfs:label xml:lang="en">Rule 4 - Open corrective actions</rdfs:label>
