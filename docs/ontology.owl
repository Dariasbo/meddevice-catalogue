    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/meddevice-catalogue#ActionStatus -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ActionStatus">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:comment xml:lang="en">A controlled vocabulary for corrective action statuses.</rdfs:comment>
        <rdfs:label xml:lang="en">ActionStatus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#ActionType -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ActionType">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:comment xml:lang="en">A controlled vocabulary for corrective action types.</rdfs:comment>
        <rdfs:label xml:lang="en">ActionType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#ActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device that depends on an energy source or active mechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">ActiveDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#CatalogueEntity -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#CatalogueEntity">
        <rdfs:comment xml:lang="en">Root class for the main entities of the catalogue.</rdfs:comment>
        <rdfs:label xml:lang="en">CatalogueEntity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#ClosedCorrectiveAction -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ClosedCorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">A corrective action whose status is closed.</rdfs:comment>
        <rdfs:label xml:lang="en">ClosedCorrectiveAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#CompetentAuthority -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#CompetentAuthority">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:comment xml:lang="en">A competent authority supervising manufacturers or regulatory activities.</rdfs:comment>
        <rdfs:label xml:lang="en">CompetentAuthority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#CorrectiveAction -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#CorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#respondsToIncident"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:comment xml:lang="en">A field safety corrective action related to an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">CorrectiveAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#Country -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#Country">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:comment xml:lang="en">A country associated with manufacturers or incident reports.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#Device -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#Device">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#hasManufacturer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#hasRiskClass"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#RiskClass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#isRegulatedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#RegulatoryFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Incident"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:comment xml:lang="en">A medical device or in vitro diagnostic device represented in the catalogue.</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#DeviceType -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#DeviceType">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:comment xml:lang="en">A controlled vocabulary for device types.</rdfs:comment>
        <rdfs:label xml:lang="en">DeviceType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#FieldSafetyCorrectiveAction -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#FieldSafetyCorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CorrectiveAction"/>
        <rdfs:comment xml:lang="en">A field safety corrective action, also known as FSCA.</rdfs:comment>
        <rdfs:label xml:lang="en">FieldSafetyCorrectiveAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#HighRiskDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#HighRiskDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:comment xml:lang="en">A device inferred or classified as high risk.</rdfs:comment>
        <rdfs:label xml:lang="en">HighRiskDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#IVDRClassA -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#IVDRClassA">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR class A.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDRClassA</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#IVDRClassB -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#IVDRClassB">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR class B.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDRClassB</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#IVDRClassC -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#IVDRClassC">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR class C.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDRClassC</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#IVDRClassD -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#IVDRClassD">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR class D.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDRClassD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#IVDRRiskClass -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#IVDRRiskClass">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#RiskClass"/>
        <rdfs:comment xml:lang="en">A risk class under the IVDR regulation.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDRRiskClass</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">A device that is both implantable and active.</rdfs:comment>
        <rdfs:label xml:lang="en">ImplantableActiveDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#ImplantableDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device intended to be implanted in the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">ImplantableDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:comment xml:lang="en">An in vitro diagnostic device regulated under IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">InVitroDiagnosticDevice</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/In_vitro_diagnostics"/>
    </owl:Class>
    


    <!-- http://www.example.org/meddevice-catalogue#Incident -->


    <owl:Class rdf:about="http://www.example.org/meddevice-catalogue#Incident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/meddevice-catalogue#CatalogueEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#affectsDevice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/meddevice-catalogue#hasAssociatedRisk"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <owl:disjointWith rdf:resource="http://www.example.org/meddevice-catalogue#Risk"/>
        <rdfs:comment xml:lang="en">A reported incident involving a device.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
    </owl:Class>
    


