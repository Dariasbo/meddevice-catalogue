        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/meddevice-catalogue#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/meddevice-catalogue#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates a device to its manufacturer.</rdfs:comment>
