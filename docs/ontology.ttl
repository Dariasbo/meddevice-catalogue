[ rdfs:comment "If a corrective action has OpenStatus, then it is classified as OpenCorrectiveAction."@en ;
  rdfs:label "Rule 4 - Open corrective actions"@en ;
  rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
  <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
  <http://www.w3.org/2003/11/swrl#head> rdf:nil
] .

[ rdfs:comment "If a device has risk class ClassD, then it is classified as a HighRiskDevice."@en ;
   rdfs:label "Rule 2 - IVDR Class D devices are high risk"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
   <http://www.w3.org/2003/11/swrl#head> rdf:nil
 ] .

[ rdfs:comment "If a device has risk class ClassIII, then it is classified as a HighRiskDevice."@en ;
   rdfs:label "Rule 1 - MDR Class III devices are high risk"@en ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> rdf:nil ;
   <http://www.w3.org/2003/11/swrl#head> rdf:nil
 ] .

[ rdfs:comment "If an incident has correctiveActionTaken equal to true, then it is classified as IncidentWithCorrectiveAction."@en ;
