###  http://www.example.org/meddevice-catalogue#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf :CatalogueEntity ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :affectsDevice ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Device
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasAssociatedRisk ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Risk
                          ] ;
          owl:disjointWith :Manufacturer ,
                           :Risk ;
          rdfs:comment "A reported incident involving a device."@en ;
          rdfs:label "Incident"@en .


###  http://www.example.org/meddevice-catalogue#IncidentType
