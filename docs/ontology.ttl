###  http://www.example.org/meddevice-catalogue#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :CatalogueEntity ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasProbabilityLevel ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :ProbabilityLevel
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasSeverityLevel ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :SeverityLevel
                      ] ;
      rdfs:comment "An identified risk associated with a device or device type."@en ;
      rdfs:label "Risk"@en .


###  http://www.example.org/meddevice-catalogue#RiskCategory
:RiskCategory rdf:type owl:Class ;
              rdfs:subClassOf :CatalogueEntity ;
