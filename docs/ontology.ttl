@prefix : <http://www.example.org/meddevice-catalogue#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.org/meddevice-catalogue#> .

<http://www.example.org/meddevice-catalogue> rdf:type owl:Ontology ;
                                              owl:versionIRI <http://www.example.org/meddevice-catalogue/1.0.0> ;
                                              <http://purl.org/dc/terms/bibliographicCitation> "David. European High-Risk Medical Devices and IVD Catalogue Ontology. Version 1.0.0, 2026."@en ;
                                              <http://purl.org/dc/terms/created> "2026-04-26"^^xsd:date ;
                                              <http://purl.org/dc/terms/creator> "David" ;
                                              <http://purl.org/dc/terms/description> "Ontology for representing medical devices, IVD devices, manufacturers, risk classes, risks, incidents and field safety corrective actions based on the CSV files provided in the PEC."@en ;
                                              <http://purl.org/dc/terms/issued> "2026-04-26"^^xsd:date ;
                                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                              <http://purl.org/dc/terms/publisher> "Universitat Oberta de Catalunya"@en ;
                                              <http://purl.org/dc/terms/source> "CSV files provided in the PEC: dispositivos, fabricantes, riesgos, incidentes and acciones correctivas."@en ;
                                              <http://purl.org/dc/terms/title> "European High-Risk Medical Devices and IVD Catalogue Ontology"@en ;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "meddevice" ;
                                              <http://purl.org/vocab/vann/preferredNamespaceUri> : ;
                                              rdfs:comment "Ontology created for a university assignment on semantic web and knowledge representation."@en ;
                                              rdfs:label "European medical device catalogue ontology"@en ;
                                              owl:versionInfo "Version 1.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument1
<http://www.w3.org/2003/11/swrl#argument1> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument2
<http://www.w3.org/2003/11/swrl#argument2> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#body
<http://www.w3.org/2003/11/swrl#body> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#classPredicate
<http://www.w3.org/2003/11/swrl#classPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#head
<http://www.w3.org/2003/11/swrl#head> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#propertyPredicate
<http://www.w3.org/2003/11/swrl#propertyPredicate> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/meddevice-catalogue#affectsDevice
:affectsDevice rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Incident ;
               rdfs:range :Device ;
               rdfs:comment "Relates an incident to the affected device."@en ;
               rdfs:label "affectsDevice"@en .


###  http://www.example.org/meddevice-catalogue#affectsDeviceType
:affectsDeviceType rdf:type owl:ObjectProperty ;
                   rdfs:domain :Risk ;
                   rdfs:range :DeviceType ;
                   rdfs:comment "Indicates the type of device affected by a risk."@en ;
                   rdfs:label "affectsDeviceType"@en .


###  http://www.example.org/meddevice-catalogue#hasActionStatus
:hasActionStatus rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :CorrectiveAction ;
                 rdfs:range :ActionStatus ;
                 rdfs:comment "Relates a corrective action to its current status."@en ;
                 rdfs:label "hasActionStatus"@en .


###  http://www.example.org/meddevice-catalogue#hasActionType
:hasActionType rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CorrectiveAction ;
               rdfs:range :ActionType ;
               rdfs:comment "Relates a corrective action to its action type."@en ;
               rdfs:label "hasActionType"@en .


###  http://www.example.org/meddevice-catalogue#hasAssociatedRisk
:hasAssociatedRisk rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :Risk ;
                   rdfs:comment "Relates an incident to its associated risk."@en ;
                   rdfs:label "hasAssociatedRisk"@en .


###  http://www.example.org/meddevice-catalogue#hasDeviceType
:hasDeviceType rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Device ;
               rdfs:range :DeviceType ;
               rdfs:comment "Relates a device to its device type."@en ;
               rdfs:label "hasDeviceType"@en .


###  http://www.example.org/meddevice-catalogue#hasIncidentType
:hasIncidentType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Incident ;
                 rdfs:range :IncidentType ;
                 rdfs:comment "Relates an incident to its incident type."@en ;
                 rdfs:label "hasIncidentType"@en .


###  http://www.example.org/meddevice-catalogue#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Relates a device to its manufacturer."@en ;
                 rdfs:label "hasManufacturer"@en .


###  http://www.example.org/meddevice-catalogue#hasPatientSex
:hasPatientSex rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Incident ;
               rdfs:range :PatientSex ;
               rdfs:comment "Relates an incident to the reported patient sex."@en ;
               rdfs:label "hasPatientSex"@en .


###  http://www.example.org/meddevice-catalogue#hasProbabilityLevel
:hasProbabilityLevel rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Risk ;
                     rdfs:range :ProbabilityLevel ;
                     rdfs:comment "Relates a risk to its probability level."@en ;
                     rdfs:label "hasProbabilityLevel"@en .


###  http://www.example.org/meddevice-catalogue#hasRiskCategory
:hasRiskCategory rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Risk ;
                 rdfs:range :RiskCategory ;
                 rdfs:comment "Relates a risk to its general risk category."@en ;
                 rdfs:label "hasRiskCategory"@en .


###  http://www.example.org/meddevice-catalogue#hasRiskClass
:hasRiskClass rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Device ;
              rdfs:range :RiskClass ;
              rdfs:comment "Relates a device to its regulatory risk class."@en ;
              rdfs:label "hasRiskClass"@en .


###  http://www.example.org/meddevice-catalogue#hasRiskType
:hasRiskType rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Risk ;
             rdfs:range :RiskType ;
             rdfs:comment "Relates a risk to its risk type."@en ;
             rdfs:label "hasRiskType"@en .


###  http://www.example.org/meddevice-catalogue#hasSeverityLevel
:hasSeverityLevel rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Risk ;
                  rdfs:range :SeverityLevel ;
                  rdfs:comment "Relates a risk to its severity level."@en ;
                  rdfs:label "hasSeverityLevel"@en .


###  http://www.example.org/meddevice-catalogue#isLocatedInCountry
:isLocatedInCountry rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Manufacturer ;
                    rdfs:range :Country ;
                    rdfs:comment "Relates a manufacturer to its country."@en ;
                    rdfs:label "isLocatedInCountry"@en .


###  http://www.example.org/meddevice-catalogue#isRegulatedBy
:isRegulatedBy rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Device ;
               rdfs:range :RegulatoryFramework ;
               rdfs:comment "Relates a device to the applicable regulatory framework."@en ;
               rdfs:label "isRegulatedBy"@en .


###  http://www.example.org/meddevice-catalogue#isSupervisedBy
:isSupervisedBy rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range :CompetentAuthority ;
                rdfs:comment "Relates a manufacturer to a competent authority."@en ;
                rdfs:label "isSupervisedBy"@en .


###  http://www.example.org/meddevice-catalogue#reportedBy
:reportedBy rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Incident ;
            rdfs:range :Manufacturer ;
            rdfs:comment "Relates an incident to the reporting manufacturer or entity."@en ;
            rdfs:label "reportedBy"@en .


###  http://www.example.org/meddevice-catalogue#reportedInCountry
:reportedInCountry rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :Country ;
                   rdfs:comment "Relates an incident to the country where it was reported."@en ;
                   rdfs:label "reportedInCountry"@en .


###  http://www.example.org/meddevice-catalogue#respondsToIncident
:respondsToIncident rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :CorrectiveAction ;
                    rdfs:range :Incident ;
                    rdfs:comment "Relates a corrective action to the incident it responds to."@en ;
                    rdfs:label "respondsToIncident"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/meddevice-catalogue#actionDate
:actionDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :CorrectiveAction ;
            rdfs:range xsd:date ;
            rdfs:comment "Corrective action date."@en ;
            rdfs:label "actionDate"@en .


###  http://www.example.org/meddevice-catalogue#actionScope
:actionScope rdf:type owl:DatatypeProperty ;
             rdfs:domain :CorrectiveAction ;
             rdfs:range xsd:string ;
             rdfs:comment "Scope of the corrective action."@en ;
             rdfs:label "actionScope"@en .


###  http://www.example.org/meddevice-catalogue#authorizationNumber
:authorizationNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manufacturer ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Authorization number."@en ;
                     rdfs:label "authorizationNumber"@en .


###  http://www.example.org/meddevice-catalogue#closureDate
:closureDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :CorrectiveAction ;
             rdfs:range xsd:date ;
             rdfs:comment "Corrective action closure date."@en ;
             rdfs:label "closureDate"@en .


###  http://www.example.org/meddevice-catalogue#contactEmail
:contactEmail rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range xsd:string ;
              rdfs:comment "Contact email."@en ;
              rdfs:label "contactEmail"@en .


###  http://www.example.org/meddevice-catalogue#correctiveActionDescription
:correctiveActionDescription rdf:type owl:DatatypeProperty ;
                             rdfs:domain :CorrectiveAction ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Corrective action description."@en ;
                             rdfs:label "correctiveActionDescription"@en .


###  http://www.example.org/meddevice-catalogue#correctiveActionTaken
:correctiveActionTaken rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Incident ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Indicates whether a corrective action was taken."@en ;
                       rdfs:label "correctiveActionTaken"@en .


###  http://www.example.org/meddevice-catalogue#countriesAffected
:countriesAffected rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CorrectiveAction ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Countries or regions affected."@en ;
                   rdfs:label "countriesAffected"@en .


###  http://www.example.org/meddevice-catalogue#detectionDate
:detectionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:date ;
               rdfs:comment "Incident detection date."@en ;
               rdfs:label "detectionDate"@en .


###  http://www.example.org/meddevice-catalogue#deviceIdentifier
:deviceIdentifier rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Device ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Device identifier."@en ;
                  rdfs:label "deviceIdentifier"@en .


###  http://www.example.org/meddevice-catalogue#deviceName
:deviceName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:string ;
            rdfs:comment "Commercial name of the device."@en ;
            rdfs:label "deviceName"@en .


###  http://www.example.org/meddevice-catalogue#devicesAffected
:devicesAffected rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CorrectiveAction ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Number or description of affected devices."@en ;
                 rdfs:label "devicesAffected"@en .


###  http://www.example.org/meddevice-catalogue#eudamedFscaReference
:eudamedFscaReference rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CorrectiveAction ;
                      rdfs:range xsd:string ;
                      rdfs:comment "EUDAMED FSCA reference."@en ;
                      rdfs:label "eudamedFscaReference"@en .


###  http://www.example.org/meddevice-catalogue#eudamedIncidentReference
:eudamedIncidentReference rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Incident ;
                          rdfs:range xsd:string ;
                          rdfs:comment "EUDAMED incident reference."@en ;
                          rdfs:label "eudamedIncidentReference"@en .


###  http://www.example.org/meddevice-catalogue#eudamedSrn
:eudamedSrn rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "EUDAMED SRN identifier."@en ;
            rdfs:label "eudamedSrn"@en .


###  http://www.example.org/meddevice-catalogue#eventDate
:eventDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :Incident ;
           rdfs:range xsd:date ;
           rdfs:comment "Incident event date."@en ;
           rdfs:label "eventDate"@en .


###  http://www.example.org/meddevice-catalogue#fscaIdentifier
:fscaIdentifier rdf:type owl:DatatypeProperty ;
                rdfs:domain :CorrectiveAction ;
                rdfs:range xsd:string ;
                rdfs:comment "FSCA identifier."@en ;
                rdfs:label "fscaIdentifier"@en .


###  http://www.example.org/meddevice-catalogue#imdrfCode
:imdrfCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:string ;
           rdfs:comment "IMDRF risk code."@en ;
           rdfs:label "imdrfCode"@en .


###  http://www.example.org/meddevice-catalogue#incidentDescription
:incidentDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Incident description."@en ;
                     rdfs:label "incidentDescription"@en .


###  http://www.example.org/meddevice-catalogue#incidentIdentifier
:incidentIdentifier rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Incident identifier."@en ;
                    rdfs:label "incidentIdentifier"@en .


###  http://www.example.org/meddevice-catalogue#intendedPurpose
:intendedPurpose rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Device ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Intended purpose of the device."@en ;
                 rdfs:label "intendedPurpose"@en .


###  http://www.example.org/meddevice-catalogue#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Indicates whether the device is active."@en ;
          rdfs:label "isActive"@en .


###  http://www.example.org/meddevice-catalogue#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Indicates whether the device is implantable."@en ;
               rdfs:label "isImplantable"@en .


###  http://www.example.org/meddevice-catalogue#isIvd
:isIvd rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:boolean ;
       rdfs:comment "Indicates whether the device is an IVD."@en ;
       rdfs:label "isIvd"@en .


###  http://www.example.org/meddevice-catalogue#isReusable
:isReusable rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Indicates whether the device is reusable."@en ;
            rdfs:label "isReusable"@en .


###  http://www.example.org/meddevice-catalogue#manufacturerIdentifier
:manufacturerIdentifier rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Manufacturer ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Manufacturer identifier."@en ;
                        rdfs:label "manufacturerIdentifier"@en .


###  http://www.example.org/meddevice-catalogue#manufacturerName
:manufacturerName rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Manufacturer ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Manufacturer name."@en ;
                  rdfs:label "manufacturerName"@en .


###  http://www.example.org/meddevice-catalogue#outcomeDescription
:outcomeDescription rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Clinical or safety outcome description."@en ;
                    rdfs:label "outcomeDescription"@en .


###  http://www.example.org/meddevice-catalogue#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:integer ;
            rdfs:comment "Patient age when available."@en ;
            rdfs:label "patientAge"@en .


###  http://www.example.org/meddevice-catalogue#reportDate
:reportDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:date ;
            rdfs:comment "Incident report date."@en ;
            rdfs:label "reportDate"@en .


###  http://www.example.org/meddevice-catalogue#riskDescription
:riskDescription rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Risk ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Risk description."@en ;
                 rdfs:label "riskDescription"@en .


###  http://www.example.org/meddevice-catalogue#riskIdentifier
:riskIdentifier rdf:type owl:DatatypeProperty ;
                rdfs:domain :Risk ;
                rdfs:range xsd:string ;
                rdfs:comment "Risk identifier."@en ;
                rdfs:label "riskIdentifier"@en .


###  http://www.example.org/meddevice-catalogue#riskName
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Risk name."@en ;
          rdfs:label "riskName"@en .


###  http://www.example.org/meddevice-catalogue#udiDi
:udiDi rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:string ;
       rdfs:comment "UDI-DI identifier."@en ;
       rdfs:label "udiDi"@en .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/meddevice-catalogue#ActionStatus
:ActionStatus rdf:type owl:Class ;
              rdfs:subClassOf :CatalogueEntity ;
              rdfs:comment "A controlled vocabulary for corrective action statuses."@en ;
              rdfs:label "ActionStatus"@en .


###  http://www.example.org/meddevice-catalogue#ActionType
:ActionType rdf:type owl:Class ;
            rdfs:subClassOf :CatalogueEntity ;
            rdfs:comment "A controlled vocabulary for corrective action types."@en ;
            rdfs:label "ActionType"@en .


###  http://www.example.org/meddevice-catalogue#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :MedicalDevice ;
              rdfs:comment "A device that depends on an energy source or active mechanism."@en ;
              rdfs:label "ActiveDevice"@en .


###  http://www.example.org/meddevice-catalogue#CatalogueEntity
:CatalogueEntity rdf:type owl:Class ;
                 rdfs:comment "Root class for the main entities of the catalogue."@en ;
                 rdfs:label "CatalogueEntity"@en .


###  http://www.example.org/meddevice-catalogue#ClosedCorrectiveAction
:ClosedCorrectiveAction rdf:type owl:Class ;
                        rdfs:subClassOf :CorrectiveAction ;
                        rdfs:comment "A corrective action whose status is closed."@en ;
                        rdfs:label "ClosedCorrectiveAction"@en .


###  http://www.example.org/meddevice-catalogue#CompetentAuthority
:CompetentAuthority rdf:type owl:Class ;
                    rdfs:subClassOf :CatalogueEntity ;
                    rdfs:comment "A competent authority supervising manufacturers or regulatory activities."@en ;
                    rdfs:label "CompetentAuthority"@en .


###  http://www.example.org/meddevice-catalogue#CorrectiveAction
:CorrectiveAction rdf:type owl:Class ;
                  rdfs:subClassOf :CatalogueEntity ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :respondsToIncident ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Incident
                                  ] ;
                  owl:disjointWith :Device ,
                                   :Incident ,
                                   :Manufacturer ,
                                   :Risk ;
                  rdfs:comment "A field safety corrective action related to an incident."@en ;
                  rdfs:label "CorrectiveAction"@en .


###  http://www.example.org/meddevice-catalogue#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :CatalogueEntity ;
         rdfs:comment "A country associated with manufacturers or incident reports."@en ;
         rdfs:label "Country"@en .


###  http://www.example.org/meddevice-catalogue#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :CatalogueEntity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturer ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Manufacturer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasRiskClass ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RiskClass
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isRegulatedBy ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RegulatoryFramework
                        ] ;
        owl:disjointWith :Incident ,
                         :Manufacturer ,
                         :Risk ;
        rdfs:comment "A medical device or in vitro diagnostic device represented in the catalogue."@en ;
        rdfs:label "Device"@en .


###  http://www.example.org/meddevice-catalogue#DeviceType
:DeviceType rdf:type owl:Class ;
            rdfs:subClassOf :CatalogueEntity ;
            rdfs:comment "A controlled vocabulary for device types."@en ;
            rdfs:label "DeviceType"@en .


###  http://www.example.org/meddevice-catalogue#FieldSafetyCorrectiveAction
:FieldSafetyCorrectiveAction rdf:type owl:Class ;
                             rdfs:subClassOf :CorrectiveAction ;
                             rdfs:comment "A field safety corrective action, also known as FSCA."@en ;
